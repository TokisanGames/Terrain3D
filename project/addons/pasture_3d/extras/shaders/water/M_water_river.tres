; Pasture3D Water — River preset. Spec §10.
;
; NOTE: the Godot editor strips these comments whenever it re-saves this file,
; which happens the moment anyone edits the preset in the inspector. If you are
; tuning a river, press "Make Unique" on the Pasture3DPool first.
;
; Unlike the other four presets this one is NOT drop-anywhere. It reads a flow
; direction out of ARRAY_COLOR, and a mesh with no vertex colours reads white,
; which decodes to a diagonal at full speed. It is meant for meshes Pasture3DPool
; built in ribbon mode; a loop pool writes the neutral (0.5, 0.5, 0) that decodes
; to a zero vector and stands still, so putting this on a lake is harmless but
; pointless.
;
; Table generated by bench/WavePresetTables.gd from the manager's `river_flow`
; profile: count 3, direction 0°, spread 10°, amplitude 0.06 m, max wavelength
; 10 m. Amplitude sum 0.134 m — that is the crest-to-trough reach and the number
; to size cull margins from, not the 0.06 knob.
;
; The series runs 10.2 / 7.2 / 5.0 m, i.e. BELOW the 10 m floor in
; WaterWaves::MIN_WAVELENGTH. That is deliberate — a river needs ripples, not two
; copies of one wave — but the floor is a float-precision limit at kilometre-scale
; coordinates, so a river far from the world origin needs _water_domain_origin
; set. Pasture3DPool does that from its own position; a bare MeshInstance3D does not.
;
; Narrow spread (10°) rather than the lake's 40°: a channel's chop runs with the
; water, it does not fan out across it.
;
; flow_period is quantised against water_time_period at runtime so the cross-fade
; cannot seam when the clock wraps. See water_flow_period() in water_common.
[gd_resource type="ShaderMaterial" format=3]

[ext_resource type="Shader" path="res://addons/pasture_3d/extras/shaders/water/water_river.gdshader" id="1_shader"]
[ext_resource type="Texture2D" uid="uid://phek6xr2elbp" path="res://addons/pasture_3d/extras/shaders/water/T_water_deriv.png" id="2_deriv"]
[ext_resource type="Texture2D" uid="uid://c54c0ur15poks" path="res://addons/pasture_3d/extras/shaders/water/T_water_foam.png" id="3_foam"]

[resource]
render_priority = 0
shader = ExtResource("1_shader")
shader_parameter/absorption = Vector3(0.6, 0.35, 0.45)
shader_parameter/deep_color = Color(0.05, 0.09, 0.08, 1)
shader_parameter/_waves = PackedVector4Array(1, 0, 0.06107, 10.17785, 0.99112, -0.13294, 0.04302, 7.16928, 0.99661, 0.08231, 0.03005, 5.00844, 1, 0, 0, 10, 1, 0, 0, 10, 1, 0, 0, 10, 1, 0, 0, 10, 1, 0, 0, 10)
shader_parameter/wave_steepness = 0.12
shader_parameter/base_roughness = 0.06
shader_parameter/specular_amount = 0.5
shader_parameter/variance_to_roughness = 0.5
shader_parameter/detail_deriv = ExtResource("2_deriv")
shader_parameter/detail_strength = 0.3
shader_parameter/detail_scale0 = 0.35
shader_parameter/detail_scale1 = 0.13
shader_parameter/detail_flow0 = Vector2(0.14, 0.05)
shader_parameter/detail_flow1 = Vector2(-0.08, 0.11)
shader_parameter/detail_fade_start = 40.0
shader_parameter/detail_fade_end = 200.0
shader_parameter/flow_period = 4.0
shader_parameter/flow_speed_scale = 8.0
shader_parameter/flow_quantise = true
shader_parameter/foam_tex = ExtResource("3_foam")
shader_parameter/foam_color = Color(0.9, 0.92, 0.94, 1)
shader_parameter/foam_scale = 0.3
shader_parameter/foam_roughness = 0.85
shader_parameter/foam_shore_depth = 0.35
shader_parameter/foam_shore_amount = 0.9

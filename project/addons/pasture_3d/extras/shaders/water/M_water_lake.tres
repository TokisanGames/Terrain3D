; Pasture3D Water — Lake preset. Spec §6.
;
; NOTE: the Godot editor strips these comments whenever it re-saves this file, which
; happens the moment anyone edits the preset in the inspector. If you are tuning a
; lake, press "Make Unique" on the Pasture3DPool first — that is exactly what the
; button is for. If this header is missing in your checkout, the preset was edited in
; place and the docs below were the collateral.
;
; Drop this on ANY MeshInstance3D. It needs no plugin, no Pasture3D node and no
; wiring (G6): the mesh's own transform positions the surface, so there is no
; sea_level uniform here — move the mesh instead.
;
; It DOES ship a wave table, unlike the ocean presets. Nothing runs in C++ for a
; bare mesh, so without one the shader would fall back to the compile-time table
; in water_common.gdshaderinc, which exists as a safety net for hand-made
; materials rather than as a preset. This table was generated by the real C++
; generator (bench/WavePresetTables.gd) from count 4, direction 35°, spread 40°,
; amplitude 0.25 m, max wavelength 25 m — so it is a shape WaterWaves would
; itself produce, which matters if this lake is ever driven from code. It is the
; same table Pasture3DPoolManager's `lake_calm` profile generates, and the Phase 4
; gate compares the two every run.
;
; Amplitude sum is 0.669 m — that is the crest-to-trough reach, and it is NOT the
; 0.25 m amplitude knob. The knob is the longest wave's amplitude and the
; geometric series adds the rest. Size cull margins off 0.669, not 0.25.
;
; The table is quantised to a 120 s loop, matching the water_time_period global's
; default. Changing that global will stop THIS material looping cleanly, because
; nothing regenerates the table for a bare mesh.
[gd_resource type="ShaderMaterial" format=4 uid="uid://cfoelhhitrvnp"]

[ext_resource type="Shader" uid="uid://baqjf2sofilby" path="res://addons/pasture_3d/extras/shaders/water/water_body.gdshader" id="1_shader"]
[ext_resource type="Texture2D" uid="uid://phek6xr2elbp" path="res://addons/pasture_3d/extras/shaders/water/T_water_deriv.png" id="2_deriv"]
[ext_resource type="Texture2D" uid="uid://c54c0ur15poks" path="res://addons/pasture_3d/extras/shaders/water/T_water_foam.png" id="3_foam"]

[resource]
render_priority = 0
shader = ExtResource("1_shader")
shader_parameter/absorption = Vector3(0.45, 0.22, 0.3)
shader_parameter/deep_color = Color(0.12708336, 0.23828125, 0.20651045, 1)
shader_parameter/_waves = PackedVector4Array(0.81915, 0.57358, 0.24981, 24.98096, 0.997, 0.07746, 0.18353, 18.35336, 0.5894, 0.80784, 0.13375, 13.3747, 0.91825, 0.396, 0.10178, 10.17785, 1, 0, 0, 10, 1, 0, 0, 10, 1, 0, 0, 10, 1, 0, 0, 10)
shader_parameter/wave_steepness = 0.25
shader_parameter/base_roughness = 0.05
shader_parameter/specular_amount = 0.5
shader_parameter/variance_to_roughness = 0.55
shader_parameter/detail_deriv = ExtResource("2_deriv")
shader_parameter/detail_strength = 0.18
shader_parameter/detail_scale0 = 0.25
shader_parameter/detail_scale1 = 0.09
shader_parameter/detail_flow0 = Vector2(0.14, 0.05)
shader_parameter/detail_flow1 = Vector2(-0.08, 0.11)
shader_parameter/detail_fade_start = 60.0
shader_parameter/detail_fade_end = 300.0
shader_parameter/foam_tex = ExtResource("3_foam")
shader_parameter/foam_color = Color(0.85, 0.89, 0.92, 1)
shader_parameter/foam_scale = 0.18
shader_parameter/foam_roughness = 0.8
shader_parameter/foam_shore_depth = 0.6
shader_parameter/foam_shore_amount = 0.7
shader_parameter/scatter_color = Color(0.09, 0.3, 0.18, 1)
shader_parameter/scatter_strength = 2.5
